<Window x:Class="TopIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopIsland"
        Width="560" Height="82"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid x:Name="Root" Background="Transparent"
          MouseEnter="Root_MouseEnter"
          MouseLeave="Root_MouseLeave">
        <Path x:Name="SurfacePath"
              Fill="{DynamicResource SurfaceBrush}"
              Stroke="{DynamicResource SurfaceBorderBrush}"
              StrokeThickness="1">
            <Path.Effect>
                <DropShadowEffect x:Name="SurfaceShadow"
                                  BlurRadius="24"
                                  ShadowDepth="6"
                                  Direction="270"
                                  Opacity="0.34"
                                  Color="#000000"/>
            </Path.Effect>
        </Path>

        <Grid x:Name="ContentHost"
              TextElement.Foreground="{DynamicResource PrimaryTextBrush}">
            <Grid x:Name="CompactBar"
                  Height="44"
                  VerticalAlignment="Top"
                  Margin="38,16,38,0"
                  Background="Transparent"
                  MouseLeftButtonUp="CompactBar_MouseLeftButtonUp">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="MediaColumn" Width="1.35*"/>
                    <ColumnDefinition x:Name="ClockColumn" Width="Auto"/>
                    <ColumnDefinition x:Name="StatsColumn" Width="Auto"/>
                    <ColumnDefinition x:Name="NetworkColumn" Width="Auto"/>
                    <ColumnDefinition x:Name="StatusColumn" Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="MediaArtworkBorder" Width="30" Height="30" CornerRadius="9" Background="#1EFFFFFF" Margin="0,0,9,0">
                        <TextBlock x:Name="MediaGlyphText" Text="♪" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="MediaTitleText" Text="TopIsland" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="154"/>
                        <TextBlock x:Name="MediaSubtitleText" Text="Windows top surface" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="154"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0" Margin="10,6" Padding="12,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ClockText" Text="18:10" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DateText" Text="8/20 Thu" FontSize="9.5" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="StatsCompact" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                    <StackPanel Margin="6,0">
                        <TextBlock Text="CPU" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="CpuText" Text="0%" FontSize="11.5" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Margin="6,0">
                        <TextBlock Text="RAM" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="RamText" Text="0%" FontSize="11.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="NetworkCompact" Grid.Column="3" VerticalAlignment="Center" Margin="8,0" Visibility="Collapsed">
                    <TextBlock Text="NET" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock x:Name="NetworkText" Text="↓ 0  ↑ 0" FontSize="10.5"/>
                </StackPanel>

                <Border Grid.Column="4" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource SuccessBrush}" Margin="10,0,2,0" VerticalAlignment="Center"/>
            </Grid>

            <Grid x:Name="ExpandedPanel" Visibility="Hidden" Opacity="0" Margin="40,76,40,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock x:Name="MediaSectionLabel" Text="Now playing" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ExpandedArtworkBorder" Width="50" Height="50" CornerRadius="12" Background="#1EFFFFFF" Margin="0,0,11,0">
                                <TextBlock x:Name="ExpandedArtworkGlyph" Text="♪" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ExpandedMediaTitle" Text="No media session yet" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ExpandedMediaSubtitle" Text="Media integration comes next" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                        <ProgressBar x:Name="MediaProgressBar" Style="{StaticResource MediaProgressStyle}" Minimum="0" Maximum="1" Value="0" Margin="0,12,0,12" IsHitTestVisible="False"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PreviousMediaButton" Style="{StaticResource QuietButtonStyle}" Content="◀" Margin="0,0,6,0" IsEnabled="False" Click="PreviousMediaButton_Click"/>
                            <Button x:Name="PlayPauseMediaButton" Style="{StaticResource QuietButtonStyle}" Content="▶" Margin="0,0,6,0" IsEnabled="False" Click="PlayPauseMediaButton_Click"/>
                            <Button x:Name="NextMediaButton" Style="{StaticResource QuietButtonStyle}" Content="▶▶" IsEnabled="False" Click="NextMediaButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="System" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CPU" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock x:Name="ExpandedCpuText" Text="0%" FontSize="19" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                <TextBlock Text="RAM" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock x:Name="ExpandedRamText" Text="0%" FontSize="19" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                        <Separator Margin="0,11" Background="{DynamicResource DividerBrush}"/>
                        <TextBlock Text="Network" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="ExpandedNetworkText" Text="↓ 0.0 Mbps   ↑ 0.0 Mbps" FontSize="11.5" Margin="0,3,0,0"/>
                        <TextBlock x:Name="UptimeText" Text="Uptime 00:00" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Surface" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="Style" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,4"/>
                        <Button x:Name="StyleToggleButton" Style="{StaticResource QuietButtonStyle}" Content="Dynamic Island" Click="StyleToggleButton_Click"/>
                        <TextBlock Text="Width" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,9,0,4"/>
                        <Button x:Name="WidthPresetButton" Style="{StaticResource QuietButtonStyle}" Content="Standard" Click="WidthPresetButton_Click"/>
                        <Slider x:Name="CustomWidthSlider" Minimum="220" Maximum="5000" Value="560" Margin="0,8,0,0" ValueChanged="CustomWidthSlider_ValueChanged"/>
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <Button x:Name="ThemeButton" Style="{StaticResource QuietButtonStyle}" Content="Theme: System" Click="ThemeButton_Click" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource QuietButtonStyle}" Content="×" ToolTip="Exit" Click="ExitButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
