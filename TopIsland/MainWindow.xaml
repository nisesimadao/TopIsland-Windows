<Window x:Class="TopIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopIsland"
        Icon="Assets/TopIsland.ico"
        Width="560" Height="68"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Geometry x:Key="PreviousGeometry">M3,4 H5 V16 H3 Z M16,4 L6,10 L16,16 Z</Geometry>
        <Geometry x:Key="PlayGeometry">M5,3 L17,10 L5,17 Z</Geometry>
        <Geometry x:Key="PauseGeometry">M5,3 H9 V17 H5 Z M13,3 H17 V17 H13 Z</Geometry>
        <Geometry x:Key="NextGeometry">M5,4 L15,10 L5,16 Z M16,4 H18 V16 H16 Z</Geometry>
        <Geometry x:Key="MediaFallbackGeometry">M6,3 H16 V5 H8 V13.2 C8,15.3 6.5,17 4.5,17 C2.6,17 1,15.8 1,14.2 C1,12.4 2.8,11 5,11 C5.4,11 5.7,11 6,11.1 Z</Geometry>
    </Window.Resources>

    <Grid x:Name="Root"
          Background="Transparent"
          MouseEnter="Root_MouseEnter"
          MouseLeave="Root_MouseLeave">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Style">
                    <MenuItem x:Name="DynamicIslandMenuItem" Header="Dynamic Island" IsCheckable="True" Click="SetDynamicIsland_Click"/>
                    <MenuItem x:Name="NotchMenuItem" Header="Notch" IsCheckable="True" Click="SetNotch_Click"/>
                </MenuItem>
                <MenuItem Header="Width">
                    <MenuItem x:Name="AuthenticWidthMenuItem" Header="Authentic" IsCheckable="True" Click="SetAuthenticWidth_Click"/>
                    <MenuItem x:Name="CompactWidthMenuItem" Header="Compact" IsCheckable="True" Click="SetCompactWidth_Click"/>
                    <MenuItem x:Name="StandardWidthMenuItem" Header="Standard" IsCheckable="True" Click="SetStandardWidth_Click"/>
                    <MenuItem x:Name="WideWidthMenuItem" Header="Wide" IsCheckable="True" Click="SetWideWidth_Click"/>
                    <MenuItem x:Name="FullWidthMenuItem" Header="Full Width" IsCheckable="True" Click="SetFullWidth_Click"/>
                </MenuItem>
                <MenuItem Header="Material">
                    <MenuItem x:Name="SolidMaterialMenuItem" Header="Black" IsCheckable="True" Click="SetSolidMaterial_Click"/>
                    <MenuItem x:Name="MicaMaterialMenuItem" Header="Mica" IsCheckable="True" Click="SetMicaMaterial_Click"/>
                    <MenuItem x:Name="AcrylicMaterialMenuItem" Header="Acrylic" IsCheckable="True" Click="SetAcrylicMaterial_Click"/>
                    <MenuItem x:Name="GlassMaterialMenuItem" Header="Glass" IsCheckable="True" Click="SetGlassMaterial_Click"/>
                    <MenuItem x:Name="MaterialCopyMenuItem" Header="Material Copy" IsCheckable="True" Click="SetMaterialCopy_Click"/>
                </MenuItem>
                <MenuItem Header="Theme">
                    <MenuItem x:Name="SystemThemeMenuItem" Header="System" IsCheckable="True" Click="SetSystemTheme_Click"/>
                    <MenuItem x:Name="DarkThemeMenuItem" Header="Dark" IsCheckable="True" Click="SetDarkTheme_Click"/>
                    <MenuItem x:Name="LightThemeMenuItem" Header="Light" IsCheckable="True" Click="SetLightTheme_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Quit TopIsland" Click="ExitButton_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <Path x:Name="SurfacePath"
              Fill="{DynamicResource SurfaceBrush}"
              Stroke="{DynamicResource SurfaceBorderBrush}"
              StrokeThickness="1">
            <Path.Effect>
                <DropShadowEffect x:Name="SurfaceShadow"
                                  BlurRadius="14"
                                  ShadowDepth="3"
                                  Direction="270"
                                  Opacity="0.25"
                                  Color="#000000"/>
            </Path.Effect>
        </Path>

        <Grid x:Name="ContentHost" TextElement.Foreground="{DynamicResource PrimaryTextBrush}">
            <Grid x:Name="CompactBar"
                  Height="32"
                  VerticalAlignment="Top"
                  Margin="30,16,30,0"
                  Background="Transparent"
                  MouseLeftButtonUp="CompactBar_MouseLeftButtonUp">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="MediaArtworkBorder"
                        Grid.Column="0"
                        Width="28" Height="28"
                        CornerRadius="6"
                        Background="#18FFFFFF"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">
                    <Viewbox Width="15" Height="15">
                        <Path x:Name="MediaGlyphPath"
                              Data="{StaticResource MediaFallbackGeometry}"
                              Fill="{DynamicResource SecondaryTextBrush}"/>
                    </Viewbox>
                </Border>

                <StackPanel x:Name="CompactMediaText" Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="MediaTitleText"
                               Text="TopIsland"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="MediaSubtitleText"
                               Text="Windows top surface"
                               FontSize="10.5"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,1,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock x:Name="CompactStatsText"
                               Text="CPU 0  ·  RAM 0"
                               FontSize="10"
                               Foreground="{DynamicResource TertiaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"/>
                    <TextBlock x:Name="ClockText"
                               Text="21:00"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="ExpandedPanel" Visibility="Hidden" Opacity="0" Margin="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="ExpandedArtworkBorder"
                        Grid.Column="0"
                        Width="90" Height="90"
                        CornerRadius="13"
                        Background="#18FFFFFF"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0">
                    <Viewbox Width="28" Height="28">
                        <Path x:Name="ExpandedArtworkGlyphPath"
                              Data="{StaticResource MediaFallbackGeometry}"
                              Fill="{DynamicResource SecondaryTextBrush}"/>
                    </Viewbox>
                </Border>

                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ExpandedMediaTitle"
                               Grid.Row="0"
                               Text="No media"
                               FontSize="17"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ExpandedMediaSubtitle"
                               Grid.Row="1"
                               Text=""
                               FontSize="12.5"
                               FontWeight="Medium"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0"/>
                    <ProgressBar x:Name="MediaProgressBar"
                                 Grid.Row="2"
                                 Style="{StaticResource MediaProgressStyle}"
                                 Minimum="0" Maximum="1" Value="0"
                                 Margin="0,12,0,0"
                                 IsHitTestVisible="False"/>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="PreviousMediaButton"
                                Style="{StaticResource IconButtonStyle}"
                                IsEnabled="False"
                                Click="PreviousMediaButton_Click">
                            <Viewbox Width="15" Height="15"><Path Data="{StaticResource PreviousGeometry}" Fill="{DynamicResource PrimaryTextBrush}"/></Viewbox>
                        </Button>
                        <Button x:Name="PlayPauseMediaButton"
                                Style="{StaticResource IconButtonStyle}"
                                Width="40" Height="40"
                                Margin="6,0"
                                IsEnabled="False"
                                Click="PlayPauseMediaButton_Click">
                            <Grid Width="18" Height="18">
                                <Viewbox x:Name="PlayIconViewbox" Width="18" Height="18"><Path Data="{StaticResource PlayGeometry}" Fill="{DynamicResource PrimaryTextBrush}"/></Viewbox>
                                <Viewbox x:Name="PauseIconViewbox" Width="18" Height="18" Visibility="Collapsed"><Path Data="{StaticResource PauseGeometry}" Fill="{DynamicResource PrimaryTextBrush}"/></Viewbox>
                            </Grid>
                        </Button>
                        <Button x:Name="NextMediaButton"
                                Style="{StaticResource IconButtonStyle}"
                                IsEnabled="False"
                                Click="NextMediaButton_Click">
                            <Viewbox Width="15" Height="15"><Path Data="{StaticResource NextGeometry}" Fill="{DynamicResource PrimaryTextBrush}"/></Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="2" Width="148" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="ExpandedClockText"
                               Text="21:00"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="ExpandedDateText"
                               Text="8/20 Thu"
                               FontSize="10.5"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Right"
                               Margin="0,1,0,14"/>
                    <TextBlock x:Name="ExpandedSystemText"
                               Text="CPU 0%   RAM 0%"
                               FontSize="10.5"
                               FontWeight="Medium"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="ExpandedNetworkText"
                               Text="↓ 0.0   ↑ 0.0 Mbps"
                               FontSize="10.5"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
