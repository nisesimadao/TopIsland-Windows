<Window x:Class="TopIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TopIsland.Controls"
        Title="TopIsland"
        Icon="Assets/TopIsland.ico"
        Width="560" Height="68"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Geometry x:Key="PreviousGeometry">M3,4 H5 V16 H3 Z M16,4 L6,10 L16,16 Z</Geometry>
        <Geometry x:Key="PlayGeometry">M5,3 L17,10 L5,17 Z</Geometry>
        <Geometry x:Key="PauseGeometry">M5,3 H9 V17 H5 Z M13,3 H17 V17 H13 Z</Geometry>
        <Geometry x:Key="NextGeometry">M5,4 L15,10 L5,16 Z M16,4 H18 V16 H16 Z</Geometry>
        <Geometry x:Key="MediaFallbackGeometry">M6,3 H16 V5 H8 V13.2 C8,15.3 6.5,17 4.5,17 C2.6,17 1,15.8 1,14.2 C1,12.4 2.8,11 5,11 C5.4,11 5.7,11 6,11.1 Z</Geometry>
        <Geometry x:Key="ActiveAppFallbackGeometry">M2,3 H18 V17 H2 Z M4,5 V15 H16 V5 Z M5,6 H8 V8 H5 Z</Geometry>
        <Geometry x:Key="MicGeometry">M10,2 C7.8,2 6,3.8 6,6 V10 C6,12.2 7.8,14 10,14 C12.2,14 14,12.2 14,10 V6 C14,3.8 12.2,2 10,2 Z M3.5,9.5 C3.5,13.1 6.3,16 10,16 C13.7,16 16.5,13.1 16.5,9.5 H14.8 C14.8,12.2 12.7,14.3 10,14.3 C7.3,14.3 5.2,12.2 5.2,9.5 Z M9,16 H11 V19 H9 Z</Geometry>
        <Geometry x:Key="HeadphonesGeometry">M3,11 C3,6.6 6.1,3 10,3 C13.9,3 17,6.6 17,11 V16 H13 V10 H15.3 C14.9,7 12.8,4.8 10,4.8 C7.2,4.8 5.1,7 4.7,10 H7 V16 H3 Z</Geometry>
        <Geometry x:Key="HangupGeometry">M3,12 C5.1,10.3 7.4,9.5 10,9.5 C12.6,9.5 14.9,10.3 17,12 L15.2,15 L12.6,13.8 L13.1,11.9 C11.1,11.2 8.9,11.2 6.9,11.9 L7.4,13.8 L4.8,15 Z</Geometry>
        <Geometry x:Key="ChatGeometry">M2,3 H18 V14 H9 L5,18 V14 H2 Z M5,6 H15 V7.5 H5 Z M5,9 H13 V10.5 H5 Z</Geometry>
    </Window.Resources>

    <Grid x:Name="Root"
          Background="Transparent"
          MouseEnter="Root_MouseEnter"
          MouseLeave="Root_MouseLeave">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Style">
                    <MenuItem x:Name="DynamicIslandMenuItem" Header="Dynamic Island" IsCheckable="True" Click="SetDynamicIsland_Click"/>
                    <MenuItem x:Name="NotchMenuItem" Header="Notch" IsCheckable="True" Click="SetNotch_Click"/>
                </MenuItem>
                <MenuItem Header="Width">
                    <MenuItem x:Name="AuthenticWidthMenuItem" Header="Authentic" IsCheckable="True" Click="SetAuthenticWidth_Click"/>
                    <MenuItem x:Name="CompactWidthMenuItem" Header="Compact" IsCheckable="True" Click="SetCompactWidth_Click"/>
                    <MenuItem x:Name="StandardWidthMenuItem" Header="Standard" IsCheckable="True" Click="SetStandardWidth_Click"/>
                    <MenuItem x:Name="WideWidthMenuItem" Header="Wide" IsCheckable="True" Click="SetWideWidth_Click"/>
                    <MenuItem x:Name="FullWidthMenuItem" Header="Full Width" IsCheckable="True" Click="SetFullWidth_Click"/>
                </MenuItem>
                <MenuItem Header="Material">
                    <MenuItem x:Name="SolidMaterialMenuItem" Header="Black" IsCheckable="True" Click="SetSolidMaterial_Click"/>
                    <MenuItem x:Name="MicaMaterialMenuItem" Header="Mica" IsCheckable="True" Click="SetMicaMaterial_Click"/>
                    <MenuItem x:Name="AcrylicMaterialMenuItem" Header="Acrylic" IsCheckable="True" Click="SetAcrylicMaterial_Click"/>
                    <MenuItem x:Name="GlassMaterialMenuItem" Header="Glass" IsCheckable="True" Click="SetGlassMaterial_Click"/>
                    <MenuItem x:Name="MaterialCopyMenuItem" Header="Material You" IsCheckable="True" Click="SetMaterialCopy_Click"/>
                </MenuItem>
                <MenuItem Header="Theme">
                    <MenuItem x:Name="SystemThemeMenuItem" Header="System" IsCheckable="True" Click="SetSystemTheme_Click"/>
                    <MenuItem x:Name="DarkThemeMenuItem" Header="Dark" IsCheckable="True" Click="SetDarkTheme_Click"/>
                    <MenuItem x:Name="LightThemeMenuItem" Header="Light" IsCheckable="True" Click="SetLightTheme_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Quit TopIsland" Click="ExitButton_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <Path x:Name="SurfacePath"
              Fill="{DynamicResource SurfaceBrush}"
              Stroke="{DynamicResource SurfaceBorderBrush}"
              StrokeThickness="1">
            <Path.Effect>
                <DropShadowEffect x:Name="SurfaceShadow"
                                  BlurRadius="10"
                                  ShadowDepth="3"
                                  Direction="270"
                                  Opacity="0.20"
                                  Color="#000000"/>
            </Path.Effect>
        </Path>

        <Grid x:Name="ContentHost"
              TextElement.Foreground="{DynamicResource PrimaryTextBrush}"
              TextOptions.TextFormattingMode="Display">
            <Grid x:Name="CompactBar"
                  Height="32"
                  VerticalAlignment="Top"
                  Margin="30,16,30,0"
                  Background="Transparent"
                  MouseLeftButtonUp="CompactBar_MouseLeftButtonUp">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="MediaArtworkBorder"
                        Grid.Column="0"
                        Width="28" Height="28"
                        CornerRadius="6"
                        Background="#18FFFFFF"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">
                    <Viewbox Width="15" Height="15">
                        <Path x:Name="MediaGlyphPath"
                              Data="{StaticResource MediaFallbackGeometry}"
                              Fill="{DynamicResource SecondaryTextBrush}"/>
                    </Viewbox>
                </Border>

                <Grid x:Name="CompactMediaText" Grid.Column="1" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="MediaTitleText"
                               Grid.Row="0"
                               Text="TopIsland"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               LineHeight="15"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="MediaSubtitleText"
                               Grid.Row="1"
                               Text="Windows top surface"
                               FontSize="10"
                               FontWeight="Normal"
                               LineHeight="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>

                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CompactActivityText" Grid.Column="0" Text="Focus 25:00" FontSize="9.5" Foreground="{DynamicResource TertiaryTextBrush}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,10,0"/>
                    <controls:RadialMeter x:Name="CompactCpuMeter" Grid.Column="1" Width="34" Height="34" ShowLabel="False" Value="0" ProgressBrush="{DynamicResource AccentBrush}" TrackBrush="{DynamicResource DividerBrush}" TextBrush="{DynamicResource PrimaryTextBrush}" SecondaryTextBrush="{DynamicResource TertiaryTextBrush}" Margin="0,0,5,0"/>
                    <controls:RadialMeter x:Name="CompactRamMeter" Grid.Column="2" Width="34" Height="34" ShowLabel="False" Value="0" ProgressBrush="{DynamicResource AccentBrush}" TrackBrush="{DynamicResource DividerBrush}" TextBrush="{DynamicResource PrimaryTextBrush}" SecondaryTextBrush="{DynamicResource TertiaryTextBrush}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="ClockText" Grid.Column="3" Text="21:00" FontSize="12.5" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <Grid x:Name="ExpandedPanel" Visibility="Hidden" Opacity="0" Margin="40">
                <Grid.RenderTransform><TranslateTransform x:Name="ExpandedTranslate" Y="-4"/></Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="178"/>
                    <RowDefinition Height="17"/>
                    <RowDefinition Height="92"/>
                </Grid.RowDefinitions>

                <Border x:Name="MaterialYouTopContainer"
                        Grid.Row="0"
                        Background="{DynamicResource SurfaceContainerLowBrush}"
                        CornerRadius="22"
                        Margin="-14,-10,-14,-6"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"/>
                <Border x:Name="MaterialYouBottomContainer"
                        Grid.Row="2"
                        Background="{DynamicResource SurfaceContainerHighBrush}"
                        CornerRadius="20"
                        Margin="-14,-5,-14,-5"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"/>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*" MinWidth="360"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="0.9*" MinWidth="190"/>
                        <ColumnDefinition x:Name="DownloadLeadingSeparatorColumn" Width="0"/>
                        <ColumnDefinition x:Name="DownloadColumn" Width="0" MinWidth="0"/>
                        <ColumnDefinition x:Name="CommunicationSeparatorColumn" Width="0"/>
                        <ColumnDefinition x:Name="DiscordVoiceColumn" Width="0" MinWidth="0"/>
                    </Grid.ColumnDefinitions>

                    <!-- Now Playing -->
                    <Grid Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="ExpandedArtworkBorder" Grid.Column="0" Width="90" Height="90" CornerRadius="13" Background="#18FFFFFF" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Viewbox Width="30" Height="30"><Path x:Name="ExpandedArtworkGlyphPath" Data="{StaticResource MediaFallbackGeometry}" Fill="{DynamicResource SecondaryTextBrush}"/></Viewbox>
                        </Border>
                        <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="360">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock x:Name="MediaSectionLabel" Text="NOW PLAYING" FontSize="9" Foreground="{DynamicResource TertiaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="ExpandedMediaTitle" Grid.Row="1" Text="No media" FontSize="17" FontWeight="SemiBold" LineHeight="21" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ExpandedMediaSubtitle" Grid.Row="2" FontSize="11.5" LineHeight="15" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                            <ProgressBar x:Name="MediaProgressBar" Grid.Row="3" Style="{StaticResource MediaProgressStyle}" Visibility="Collapsed" Minimum="0" Maximum="1" Value="0" Margin="0,10,0,0" IsHitTestVisible="False"/>
                            <Grid Grid.Row="4" Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="MediaPositionText" Text="0:00" FontSize="8.5" Foreground="{DynamicResource TertiaryTextBrush}" Typography.NumeralAlignment="Tabular"/><TextBlock x:Name="MediaDurationText" Grid.Column="1" Text="0:00" FontSize="8.5" Foreground="{DynamicResource TertiaryTextBrush}" Typography.NumeralAlignment="Tabular"/></Grid>
                            <StackPanel x:Name="MediaControlsPanel" Grid.Row="5" Orientation="Horizontal" Visibility="Collapsed" Margin="0,6,0,0">
                                <Button x:Name="PreviousMediaButton" Style="{StaticResource IconButtonStyle}" IsEnabled="False" Click="PreviousMediaButton_Click"><Viewbox Width="15" Height="15"><Path Data="{StaticResource PreviousGeometry}" Fill="{DynamicResource PrimaryTextBrush}"/></Viewbox></Button>
                                <Button x:Name="PlayPauseMediaButton" Style="{StaticResource PrimaryIconButtonStyle}" Width="40" Height="40" Margin="6,0" IsEnabled="False" Click="PlayPauseMediaButton_Click"><Grid Width="18" Height="18"><Viewbox x:Name="PlayIconViewbox" Width="18" Height="18"><Path Data="{StaticResource PlayGeometry}" Fill="{DynamicResource OnPrimaryContainerBrush}"/></Viewbox><Viewbox x:Name="PauseIconViewbox" Width="18" Height="18" Visibility="Collapsed"><Path Data="{StaticResource PauseGeometry}" Fill="{DynamicResource OnPrimaryContainerBrush}"/></Viewbox></Grid></Button>
                                <Button x:Name="NextMediaButton" Style="{StaticResource IconButtonStyle}" IsEnabled="False" Click="NextMediaButton_Click"><Viewbox Width="15" Height="15"><Path Data="{StaticResource NextGeometry}" Fill="{DynamicResource PrimaryTextBrush}"/></Viewbox></Button>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerBrush}" Margin="0,4"/>

                    <!-- System -->
                    <Grid Grid.Column="2" Margin="18,0" VerticalAlignment="Center">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="SYSTEM" FontSize="9" Foreground="{DynamicResource TertiaryTextBrush}"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,3,0,0">
                            <TextBlock x:Name="ExpandedClockText" Text="21:00" FontSize="25" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                            <TextBlock x:Name="ExpandedDateText" Text="8/20 Thu" FontSize="9.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="9,0,0,3" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <Grid Grid.Row="3" Margin="0,2,0,0" MaxWidth="360" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <controls:RadialMeter x:Name="CpuRadialMeter" Grid.Column="0" Label="CPU" Value="0" ProgressBrush="{DynamicResource AccentBrush}" TrackBrush="{DynamicResource DividerBrush}" TextBrush="{DynamicResource PrimaryTextBrush}" SecondaryTextBrush="{DynamicResource TertiaryTextBrush}" HorizontalAlignment="Center"/>
                            <controls:RadialMeter x:Name="GpuRadialMeter" Grid.Column="1" Label="GPU" Value="0" ProgressBrush="{DynamicResource AccentBrush}" TrackBrush="{DynamicResource DividerBrush}" TextBrush="{DynamicResource PrimaryTextBrush}" SecondaryTextBrush="{DynamicResource TertiaryTextBrush}" HorizontalAlignment="Center"/>
                            <controls:RadialMeter x:Name="RamRadialMeter" Grid.Column="2" Label="RAM" Value="0" ProgressBrush="{DynamicResource AccentBrush}" TrackBrush="{DynamicResource DividerBrush}" TextBrush="{DynamicResource PrimaryTextBrush}" SecondaryTextBrush="{DynamicResource TertiaryTextBrush}" HorizontalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="ExpandedSystemText" Grid.Row="4" Visibility="Collapsed"/>
                        <TextBlock x:Name="ExpandedNetworkText" Grid.Row="5" Text="&#x2193; 0.0   &#x2191; 0.0 Mbps" FontSize="9.5" Foreground="{DynamicResource SecondaryTextBrush}" Typography.NumeralAlignment="Tabular" Margin="0,8,0,0"/>
                        <TextBlock x:Name="HardwareDetailText" Grid.Row="6" Text="Temperature unavailable" FontSize="9.5" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                    </Grid>

                    <Border x:Name="DownloadLeadingSeparator" Grid.Column="3" Width="1" Visibility="Collapsed" Background="{DynamicResource DividerBrush}" Margin="0,4"/>

                    <!-- Downloads: this whole column exists only while a real download is active. -->
                    <Grid x:Name="DownloadGroup" Grid.Column="4" Visibility="Collapsed" Margin="18,0" VerticalAlignment="Center">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="DOWNLOADS" FontSize="9" Foreground="{DynamicResource TertiaryTextBrush}"/>
                        <StackPanel x:Name="DownloadItem1Group" Grid.Row="1" Margin="0,7,0,0">
                            <TextBlock x:Name="DownloadPrimaryText" Text="No active downloads" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="DownloadDetailText" FontSize="9.5" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="DownloadItem2Group" Grid.Row="2" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="DownloadSecondaryText" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="DownloadSecondaryDetailText" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" Margin="0,1,0,0"/>
                        </StackPanel>
                        <ProgressBar x:Name="DownloadActivityProgressBar" Grid.Row="3" Style="{StaticResource MediaProgressStyle}" IsIndeterminate="True" Visibility="Collapsed" Height="4" Margin="0,9,0,0"/>
                    </Grid>

                    <Border x:Name="CommunicationSeparator" Grid.Column="5" Width="1" Visibility="Collapsed" Background="{DynamicResource DividerBrush}" Margin="0,4"/>

                    <!-- Communication / Discord -->
                    <Grid x:Name="DiscordVoiceGroup" Grid.Column="6" Margin="18,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="COMMUNICATION" FontSize="9" Foreground="{DynamicResource TertiaryTextBrush}"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,7,0,0">
                            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SecondaryContainerBrush}" Margin="0,0,10,0">
                                <Viewbox Width="17" Height="17"><Path Data="{StaticResource ChatGeometry}" Fill="{DynamicResource PrimaryTextBrush}"/></Viewbox>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="DiscordVoiceStateText" Text="Discord" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DiscordVoiceChannelText" Text="Not in voice" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="DiscordVoiceDetailText" Grid.Row="2" Text="Discord is not connected" FontSize="9.5" Foreground="{DynamicResource TertiaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/>
                        <StackPanel x:Name="DiscordVoiceStatusStrip" Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                            <Viewbox Width="12" Height="12" Margin="0,0,6,0"><Path Data="{StaticResource MicGeometry}" Fill="{DynamicResource SecondaryTextBrush}"/></Viewbox>
                            <TextBlock x:Name="DiscordVoiceStatusText" Text="Mic live &#183; Audio on" FontSize="9.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <StackPanel x:Name="DiscordVoiceControlsPanel" Grid.Row="4" Orientation="Horizontal" Margin="0,7,0,0" Visibility="Collapsed">
                            <Button x:Name="DiscordMuteButton" Style="{StaticResource IconButtonStyle}" Width="30" Height="30" Margin="0,0,6,0" Click="DiscordMuteButton_Click" ToolTip="Mute / unmute microphone" AutomationProperties.Name="Toggle Discord microphone">
                                <Viewbox Width="14" Height="14"><Path Data="{StaticResource MicGeometry}" Fill="{DynamicResource PrimaryTextBrush}"/></Viewbox>
                            </Button>
                            <Button x:Name="DiscordDeafenButton" Style="{StaticResource IconButtonStyle}" Width="30" Height="30" Margin="0,0,6,0" Click="DiscordDeafenButton_Click" ToolTip="Speaker mute / unmute" AutomationProperties.Name="Toggle Discord speaker mute">
                                <Viewbox Width="14" Height="14"><Path Data="{StaticResource HeadphonesGeometry}" Fill="{DynamicResource PrimaryTextBrush}"/></Viewbox>
                            </Button>
                            <Button x:Name="DiscordDisconnectButton" Style="{StaticResource IconButtonStyle}" Width="30" Height="30" Click="DiscordDisconnectButton_Click" ToolTip="Leave Discord voice" AutomationProperties.Name="Leave Discord voice">
                                <Viewbox Width="14" Height="14"><Path Data="{StaticResource HangupGeometry}" Fill="#FFE15B64"/></Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Border Grid.Row="1" Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center"/>

                <Grid Grid.Row="2" Height="92">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="205"/><ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="190"/><ColumnDefinition Width="1"/>
                        <ColumnDefinition x:Name="NotificationColumn" Width="*" MaxWidth="520"/><ColumnDefinition Width="1"/>
                        <ColumnDefinition x:Name="BatteryColumn" Width="0"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="TIMERS" FontSize="9" Foreground="{DynamicResource TertiaryTextBrush}" Margin="0,0,0,4"/>
                        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="FocusTimerLabelText" Text="Focus" FontSize="10"/><TextBlock x:Name="FocusTimerText" Grid.Column="1" Text="25:00" FontSize="10.5" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Margin="8,0"/><Button x:Name="FocusToggleButton" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="24" Height="24" Click="FocusToggleButton_Click"><Grid Width="11" Height="11"><Viewbox x:Name="FocusPlayIconViewbox" Width="11" Height="11"><Path Data="{StaticResource PlayGeometry}" Fill="{DynamicResource PrimaryTextBrush}"/></Viewbox><Viewbox x:Name="FocusPauseIconViewbox" Width="11" Height="11" Visibility="Collapsed"><Path Data="{StaticResource PauseGeometry}" Fill="{DynamicResource PrimaryTextBrush}"/></Viewbox></Grid></Button></Grid>
                        <Grid Grid.Row="2" Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Break" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock Text="45:00" Grid.Column="1" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Typography.NumeralAlignment="Tabular" Margin="8,0"/><Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="24" Height="24" Click="Break45Button_Click"><Viewbox Width="11" Height="11"><Path Data="{StaticResource PlayGeometry}" Fill="{DynamicResource SecondaryTextBrush}"/></Viewbox></Button></Grid>
                    </Grid>
                    <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerBrush}" Margin="0,4"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0"><TextBlock Text="STORAGE" FontSize="9" Foreground="{DynamicResource TertiaryTextBrush}"/><TextBlock x:Name="StorageText" Text="-- free" FontSize="11" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0"/><ProgressBar x:Name="StorageProgressBar" Style="{StaticResource MediaProgressStyle}" Minimum="0" Maximum="1" Value="0" Height="4" Margin="0,5,0,0" IsHitTestVisible="False"/></StackPanel>
                    <StackPanel x:Name="NotificationStripGroup" Grid.Column="4" VerticalAlignment="Center" Margin="16,0">
                        <TextBlock Text="NOTIFICATIONS" FontSize="9" Foreground="{DynamicResource TertiaryTextBrush}" Margin="0,0,0,3"/>
                        <Grid x:Name="NotificationItem1Group"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="NotificationPrimaryText" Text="No notifications" FontSize="10.5" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="NotificationAge1Text" Grid.Column="1" FontSize="8.5" Foreground="{DynamicResource TertiaryTextBrush}" Margin="8,0,0,0"/></Grid>
                        <TextBlock x:Name="NotificationDetailText" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                        <Grid x:Name="NotificationItem2Group" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="NotificationPrimary2Text" FontSize="9.5" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="NotificationAge2Text" Grid.Column="1" FontSize="8.5" Foreground="{DynamicResource TertiaryTextBrush}" Margin="8,0,0,0"/></Grid>
                        <Grid x:Name="NotificationItem3Group" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="NotificationPrimary3Text" FontSize="9.5" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="NotificationAge3Text" Grid.Column="1" FontSize="8.5" Foreground="{DynamicResource TertiaryTextBrush}" Margin="8,0,0,0"/></Grid>
                    </StackPanel>
                    <Border x:Name="NotificationSeparator" Grid.Column="3" Width="1" Background="{DynamicResource DividerBrush}" Margin="0,4" Visibility="Visible"/>
                    <Border x:Name="BatterySeparator" Grid.Column="5" Width="1" Background="{DynamicResource DividerBrush}" Margin="0,4" Visibility="Collapsed"/>
                    <StackPanel x:Name="BatteryStripGroup" Grid.Column="6" VerticalAlignment="Center" Margin="16,0,0,0" Visibility="Collapsed"><TextBlock Text="BATTERY" FontSize="9" Foreground="{DynamicResource TertiaryTextBrush}"/><TextBlock x:Name="BatteryText" Text="--" FontSize="11" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0"/><TextBlock x:Name="BatteryStateText" FontSize="9.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,1,0,0"/></StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
