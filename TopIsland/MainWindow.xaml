<Window x:Class="TopIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TopIsland.Controls"
        Title="TopIsland"
        Icon="Assets/TopIsland.ico"
        Width="560" Height="68"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Geometry x:Key="PreviousGeometry">M3,4 H5 V16 H3 Z M16,4 L6,10 L16,16 Z</Geometry>
        <Geometry x:Key="PlayGeometry">M5,3 L17,10 L5,17 Z</Geometry>
        <Geometry x:Key="PauseGeometry">M5,3 H9 V17 H5 Z M13,3 H17 V17 H13 Z</Geometry>
        <Geometry x:Key="NextGeometry">M5,4 L15,10 L5,16 Z M16,4 H18 V16 H16 Z</Geometry>
        <Geometry x:Key="MediaFallbackGeometry">M6,3 H16 V5 H8 V13.2 C8,15.3 6.5,17 4.5,17 C2.6,17 1,15.8 1,14.2 C1,12.4 2.8,11 5,11 C5.4,11 5.7,11 6,11.1 Z</Geometry>
        <Geometry x:Key="ActiveAppFallbackGeometry">M2,3 H18 V17 H2 Z M4,5 V15 H16 V5 Z M5,6 H8 V8 H5 Z</Geometry>
        <Geometry x:Key="MicGeometry">M10,2 C7.8,2 6,3.8 6,6 V10 C6,12.2 7.8,14 10,14 C12.2,14 14,12.2 14,10 V6 C14,3.8 12.2,2 10,2 Z M3.5,9.5 C3.5,13.1 6.3,16 10,16 C13.7,16 16.5,13.1 16.5,9.5 H14.8 C14.8,12.2 12.7,14.3 10,14.3 C7.3,14.3 5.2,12.2 5.2,9.5 Z M9,16 H11 V19 H9 Z</Geometry>
        <Geometry x:Key="HeadphonesGeometry">M3,11 C3,6.6 6.1,3 10,3 C13.9,3 17,6.6 17,11 V16 H13 V10 H15.3 C14.9,7 12.8,4.8 10,4.8 C7.2,4.8 5.1,7 4.7,10 H7 V16 H3 Z</Geometry>
        <Geometry x:Key="HangupGeometry">M3,12 C5.1,10.3 7.4,9.5 10,9.5 C12.6,9.5 14.9,10.3 17,12 L15.2,15 L12.6,13.8 L13.1,11.9 C11.1,11.2 8.9,11.2 6.9,11.9 L7.4,13.8 L4.8,15 Z</Geometry>
        <Geometry x:Key="ChatGeometry">M2,3 H18 V14 H9 L5,18 V14 H2 Z M5,6 H15 V7.5 H5 Z M5,9 H13 V10.5 H5 Z</Geometry>
        <Geometry x:Key="BellGeometry">M10,2 C7.8,2 6,3.8 6,6 V9 C6,10.8 5.2,12.1 4,13 H16 C14.8,12.1 14,10.8 14,9 V6 C14,3.8 12.2,2 10,2 Z M8,15 H12 C11.6,16.2 10.9,17 10,17 C9.1,17 8.4,16.2 8,15 Z</Geometry>
        <Geometry x:Key="DownloadGeometry">M9,2 H11 V10 L14,7 L15.4,8.4 L10,13.8 L4.6,8.4 L6,7 L9,10 Z M3,15 H17 V17 H3 Z</Geometry>
        <Geometry x:Key="SettingsGeometry">M12,2.5 L13.1,5.1 C13.7,5.3 14.3,5.6 14.8,6 L17.5,5 L19,7.6 L16.9,9.4 C17,9.9 17.1,10.5 17.1,11 C17.1,11.5 17,12.1 16.9,12.6 L19,14.4 L17.5,17 L14.8,16 C14.3,16.4 13.7,16.7 13.1,16.9 L12,19.5 H9 L7.9,16.9 C7.3,16.7 6.7,16.4 6.2,16 L3.5,17 L2,14.4 L4.1,12.6 C4,12.1 3.9,11.5 3.9,11 C3.9,10.5 4,9.9 4.1,9.4 L2,7.6 L3.5,5 L6.2,6 C6.7,5.6 7.3,5.3 7.9,5.1 L9,2.5 Z M10.5,8 A3,3 0 1 0 10.5,14 A3,3 0 0 0 10.5,8 Z</Geometry>
        <Style x:Key="MediaSeekStyle" TargetType="Slider">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="12" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="{DynamicResource AccentBrush}" BorderThickness="0" Height="4" VerticalAlignment="Center"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="10" Height="10" Background="{DynamicResource AccentBrush}">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{TemplateBinding Background}"/></ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root"
          Background="Transparent"
          MouseEnter="Root_MouseEnter"
          MouseLeave="Root_MouseLeave">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Style">
                    <MenuItem x:Name="DynamicIslandMenuItem" Header="Dynamic Island" IsCheckable="True" Click="SetDynamicIsland_Click"/>
                    <MenuItem x:Name="NotchMenuItem" Header="Notch" IsCheckable="True" Click="SetNotch_Click"/>
                </MenuItem>
                <MenuItem Header="Width">
                    <MenuItem x:Name="AuthenticWidthMenuItem" Header="Authentic" IsCheckable="True" Click="SetAuthenticWidth_Click"/>
                    <MenuItem x:Name="CompactWidthMenuItem" Header="Compact" IsCheckable="True" Click="SetCompactWidth_Click"/>
                    <MenuItem x:Name="StandardWidthMenuItem" Header="Standard" IsCheckable="True" Click="SetStandardWidth_Click"/>
                    <MenuItem x:Name="WideWidthMenuItem" Header="Wide" IsCheckable="True" Click="SetWideWidth_Click"/>
                    <MenuItem x:Name="FullWidthMenuItem" Header="Full Width" IsCheckable="True" Click="SetFullWidth_Click"/>
                </MenuItem>
                <MenuItem Header="Material">
                    <MenuItem x:Name="SolidMaterialMenuItem" Header="Black" IsCheckable="True" Click="SetSolidMaterial_Click"/>
                    <MenuItem x:Name="MicaMaterialMenuItem" Header="Mica" IsCheckable="True" Click="SetMicaMaterial_Click"/>
                    <MenuItem x:Name="AcrylicMaterialMenuItem" Header="Acrylic" IsCheckable="True" Click="SetAcrylicMaterial_Click"/>
                    <MenuItem x:Name="GlassMaterialMenuItem" Header="Glass" IsCheckable="True" Click="SetGlassMaterial_Click"/>
                    <MenuItem x:Name="MaterialCopyMenuItem" Header="Material You" IsCheckable="True" Click="SetMaterialCopy_Click"/>
                </MenuItem>
                <MenuItem Header="Theme">
                    <MenuItem x:Name="SystemThemeMenuItem" Header="System" IsCheckable="True" Click="SetSystemTheme_Click"/>
                    <MenuItem x:Name="DarkThemeMenuItem" Header="Dark" IsCheckable="True" Click="SetDarkTheme_Click"/>
                    <MenuItem x:Name="LightThemeMenuItem" Header="Light" IsCheckable="True" Click="SetLightTheme_Click"/>
                </MenuItem>
                <MenuItem Header="Behavior">
                    <MenuItem x:Name="TopEdgeRevealMenuItem" Header="Reveal on top edge" IsCheckable="True" Click="ToggleTopEdgeReveal_Click" ToolTip="Hide while idle and reveal when the pointer reaches the top-center edge"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Quit TopIsland" Click="ExitButton_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <Path x:Name="SurfacePath"
              Fill="{DynamicResource SurfaceBrush}"
              Stroke="{DynamicResource SurfaceBorderBrush}"
              StrokeThickness="1">
            <Path.Effect>
                <DropShadowEffect x:Name="SurfaceShadow"
                                  BlurRadius="10"
                                  ShadowDepth="3"
                                  Direction="270"
                                  Opacity="0.20"
                                  Color="#000000"/>
            </Path.Effect>
        </Path>

        <Grid x:Name="ContentHost"
              TextElement.Foreground="{DynamicResource PrimaryTextBrush}"
              TextOptions.TextFormattingMode="Display">
            <Grid x:Name="CompactBar"
                  Height="34"
                  VerticalAlignment="Top"
                  Margin="30,18,30,0"
                  Background="Transparent"
                  MouseLeftButtonUp="CompactBar_MouseLeftButtonUp">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="MediaArtworkBorder" Grid.Column="0" Width="30" Height="30" CornerRadius="7" Background="#18FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Viewbox Width="15" Height="15"><Path x:Name="MediaGlyphPath" Data="{StaticResource MediaFallbackGeometry}" Fill="{DynamicResource SecondaryTextBrush}"/></Viewbox>
                </Border>

                <Grid x:Name="CompactMediaText" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="260" MinWidth="0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="MediaTitleText" Text="TopIsland" FontSize="12.5" FontWeight="SemiBold" LineHeight="15" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="MediaSubtitleText" Grid.Row="1" Text="Windows top surface" FontSize="9.5" LineHeight="11" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <StackPanel x:Name="CompactTransportPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0" Visibility="Collapsed">
                    <Button Style="{StaticResource IconButtonStyle}" Width="26" Height="26" Click="PreviousMediaButton_Click"><Viewbox Width="12" Height="12"><Path Data="{StaticResource PreviousGeometry}" Fill="{DynamicResource PrimaryTextBrush}"/></Viewbox></Button>
                    <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Margin="2,0" Click="PlayPauseMediaButton_Click">
                        <Grid Width="13" Height="13"><Viewbox x:Name="CompactPlayIconViewbox" Width="13" Height="13"><Path Data="{StaticResource PlayGeometry}" Fill="{DynamicResource PrimaryTextBrush}"/></Viewbox><Viewbox x:Name="CompactPauseIconViewbox" Width="13" Height="13" Visibility="Collapsed"><Path Data="{StaticResource PauseGeometry}" Fill="{DynamicResource PrimaryTextBrush}"/></Viewbox></Grid>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Width="26" Height="26" Click="NextMediaButton_Click"><Viewbox Width="12" Height="12"><Path Data="{StaticResource NextGeometry}" Fill="{DynamicResource PrimaryTextBrush}"/></Viewbox></Button>
                </StackPanel>

                <Grid x:Name="FullWidthInfoPanel" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="360,0,18,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="1"/>
                        <ColumnDefinition x:Name="FullDiscordColumn" Width="0"/><ColumnDefinition x:Name="FullDiscordSeparatorColumn" Width="0"/>
                        <ColumnDefinition x:Name="FullDownloadColumn" Width="0"/><ColumnDefinition x:Name="FullDownloadSeparatorColumn" Width="0"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="FullFocusGroup" Grid.Column="0" VerticalAlignment="Center" Margin="10,0">
                        <TextBlock Text="FOCUS" FontSize="7.5" Foreground="{DynamicResource TertiaryTextBrush}"/>
                        <TextBlock x:Name="FullFocusText" Text="25:00" FontSize="10" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerBrush}" Margin="0,4"/>
                    <StackPanel x:Name="FullDiscordGroup" Grid.Column="2" VerticalAlignment="Center" Margin="10,0" Visibility="Collapsed">
                        <TextBlock Text="VOICE" FontSize="7.5" Foreground="{DynamicResource TertiaryTextBrush}"/>
                        <TextBlock x:Name="FullDiscordText" Text="Discord VC" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="3" Width="1" Background="{DynamicResource DividerBrush}" Margin="0,4"/>
                    <StackPanel x:Name="FullDownloadGroup" Grid.Column="4" VerticalAlignment="Center" Margin="10,0" Visibility="Collapsed">
                        <TextBlock Text="DOWNLOADS" FontSize="7.5" Foreground="{DynamicResource TertiaryTextBrush}"/>
                        <TextBlock x:Name="FullDownloadText" Text="1 active" FontSize="10" FontWeight="SemiBold" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="5" Width="1" Background="{DynamicResource DividerBrush}" Margin="0,4"/>
                    <StackPanel Grid.Column="6" VerticalAlignment="Center" Margin="10,0">
                        <TextBlock Text="NETWORK" FontSize="7.5" Foreground="{DynamicResource TertiaryTextBrush}"/>
                        <TextBlock x:Name="FullNetworkText" Text="↓ 0.0  ↑ 0.0" FontSize="10" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="7" Width="1" Background="{DynamicResource DividerBrush}" Margin="0,4"/>
                    <StackPanel Grid.Column="8" VerticalAlignment="Center" Margin="10,0">
                        <TextBlock Text="STORAGE" FontSize="7.5" Foreground="{DynamicResource TertiaryTextBrush}"/>
                        <TextBlock x:Name="FullStorageText" Text="-- free" FontSize="10" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="3" Background="{DynamicResource DividerBrush}" Margin="0,5"/>
                <StackPanel x:Name="CompactClockPanel" Grid.Column="4" VerticalAlignment="Center" Margin="10,0,10,0">
                    <TextBlock x:Name="ClockText" Text="21:00" FontSize="13" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CompactDateText" Text="8/22" FontSize="8" Foreground="{DynamicResource TertiaryTextBrush}" HorizontalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>

                <Border Grid.Column="5" Background="{DynamicResource DividerBrush}" Margin="0,5"/>
                <Grid x:Name="CompactMetersHost" Grid.Column="6" Height="34" Width="88" ClipToBounds="False" VerticalAlignment="Center" Margin="6,0,0,0">
                    <StackPanel x:Name="CompactMetersPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <controls:RadialMeter x:Name="CompactCpuMeter" Width="43" Height="34" Label="CPU" ShowLabel="False" IsTachometer="True" Value="0" ProgressBrush="{DynamicResource AccentBrush}" TrackBrush="{DynamicResource DividerBrush}" TextBrush="{DynamicResource PrimaryTextBrush}" SecondaryTextBrush="{DynamicResource TertiaryTextBrush}" Margin="0,0,2,0"/>
                        <controls:RadialMeter x:Name="CompactRamMeter" Width="43" Height="34" Label="RAM" ShowLabel="False" IsTachometer="True" Value="0" ProgressBrush="{DynamicResource AccentBrush}" TrackBrush="{DynamicResource DividerBrush}" TextBrush="{DynamicResource PrimaryTextBrush}" SecondaryTextBrush="{DynamicResource TertiaryTextBrush}"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="7" Background="{DynamicResource DividerBrush}" Margin="0,5"/>
                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,0,0">
                    <StackPanel x:Name="CompactIndicatorsPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <StackPanel x:Name="CompactNotificationIndicator" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,8,0">
                            <Viewbox Width="12" Height="12"><Path Data="{StaticResource BellGeometry}" Fill="{DynamicResource SecondaryTextBrush}"/></Viewbox>
                            <TextBlock x:Name="CompactNotificationText" Text="0" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="3,0,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="CompactDownloadIndicator" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <Viewbox Width="12" Height="12"><Path Data="{StaticResource DownloadGeometry}" Fill="{DynamicResource SecondaryTextBrush}"/></Viewbox>
                            <TextBlock x:Name="CompactDownloadText" Text="0" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="3,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="CompactFocusGroup" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="10,0,0,0">
                        <TextBlock x:Name="CompactFocusText" Text="Focus 25:00" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource IconButtonStyle}" Width="24" Height="24" Margin="4,0,0,0" Click="FocusToggleButton_Click" ToolTip="Pause / resume focus timer" AutomationProperties.Name="Toggle focus timer">
                            <Grid Width="10" Height="10"><Viewbox x:Name="CompactFocusPlayIconViewbox" Width="10" Height="10" Visibility="Collapsed"><Path Data="{StaticResource PlayGeometry}" Fill="{DynamicResource PrimaryTextBrush}"/></Viewbox><Viewbox x:Name="CompactFocusPauseIconViewbox" Width="10" Height="10"><Path Data="{StaticResource PauseGeometry}" Fill="{DynamicResource PrimaryTextBrush}"/></Viewbox></Grid>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="CompactActivityText" Text="Focus 25:00" FontSize="9" Foreground="{DynamicResource TertiaryTextBrush}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Visibility="Collapsed" Margin="10,0,0,0"/>
                    <Button x:Name="FullSettingsButton" Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Margin="8,0,0,0" Visibility="Collapsed" Click="FullSettingsButton_Click" ToolTip="TopIsland settings" AutomationProperties.Name="TopIsland settings"><Viewbox Width="13" Height="13"><Path Data="{StaticResource SettingsGeometry}" Fill="{DynamicResource SecondaryTextBrush}"/></Viewbox></Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="ExpandedPanel" Visibility="Hidden" Opacity="0" Margin="32,24,32,24">
                <Grid.RenderTransform><TranslateTransform x:Name="ExpandedTranslate" Y="-4"/></Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="13"/>
                    <RowDefinition Height="112"/>
                </Grid.RowDefinitions>

                <Border x:Name="MaterialYouTopContainer" Grid.Row="0" Background="{DynamicResource SurfaceContainerLowBrush}" CornerRadius="20" Margin="-10,-8,-10,-4" Visibility="Collapsed" IsHitTestVisible="False"/>
                <Border x:Name="MaterialYouBottomContainer" Grid.Row="2" Background="{DynamicResource SurfaceContainerHighBrush}" CornerRadius="18" Margin="-10,-4,-10,-6" Visibility="Collapsed" IsHitTestVisible="False"/>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ContextColumn" Width="1.08*" MinWidth="300"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition x:Name="OverviewColumn" Width="1.04*" MinWidth="292"/>
                        <ColumnDefinition x:Name="NotificationSeparatorColumn" Width="0"/>
                        <ColumnDefinition x:Name="NotificationColumn" Width="0" MinWidth="0" MaxWidth="310"/>
                    </Grid.ColumnDefinitions>

                    <!-- Now Playing / Active App -->
                    <Grid Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="ExpandedArtworkBorder" Grid.Column="0" Width="100" Height="112" CornerRadius="14" Background="#18FFFFFF" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Viewbox Width="31" Height="31"><Path x:Name="ExpandedArtworkGlyphPath" Data="{StaticResource MediaFallbackGeometry}" Fill="{DynamicResource SecondaryTextBrush}"/></Viewbox>
                        </Border>
                        <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" MinWidth="0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock x:Name="MediaSectionLabel" Text="NOW PLAYING" FontSize="8.5" Foreground="{DynamicResource TertiaryTextBrush}" Margin="0,0,0,3"/>
                            <TextBlock x:Name="ExpandedMediaTitle" Grid.Row="1" Text="No media" FontSize="16" FontWeight="SemiBold" LineHeight="20" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ExpandedMediaSubtitle" Grid.Row="2" FontSize="10.5" LineHeight="14" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                            <Slider x:Name="MediaSeekSlider" Grid.Row="3" Style="{StaticResource MediaSeekStyle}" Visibility="Collapsed" Value="0" Margin="0,7,0,0" PreviewMouseLeftButtonUp="MediaSeekSlider_MouseLeftButtonUp"/>
                            <Grid Grid.Row="4" Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="MediaPositionText" Text="0:00" FontSize="8" Foreground="{DynamicResource TertiaryTextBrush}" Typography.NumeralAlignment="Tabular"/><TextBlock x:Name="MediaDurationText" Grid.Column="1" Text="0:00" FontSize="8" Foreground="{DynamicResource TertiaryTextBrush}" Typography.NumeralAlignment="Tabular"/></Grid>
                            <StackPanel x:Name="MediaControlsPanel" Grid.Row="5" Orientation="Horizontal" Visibility="Collapsed" Margin="0,6,0,0">
                                <Button x:Name="PreviousMediaButton" Style="{StaticResource IconButtonStyle}" IsEnabled="False" Click="PreviousMediaButton_Click"><Viewbox Width="14" Height="14"><Path Data="{StaticResource PreviousGeometry}" Fill="{DynamicResource PrimaryTextBrush}"/></Viewbox></Button>
                                <Button x:Name="PlayPauseMediaButton" Style="{StaticResource PrimaryIconButtonStyle}" Width="38" Height="38" Margin="5,0" IsEnabled="False" Click="PlayPauseMediaButton_Click"><Grid Width="17" Height="17"><Viewbox x:Name="PlayIconViewbox" Width="17" Height="17"><Path Data="{StaticResource PlayGeometry}" Fill="{DynamicResource OnPrimaryContainerBrush}"/></Viewbox><Viewbox x:Name="PauseIconViewbox" Width="17" Height="17" Visibility="Collapsed"><Path Data="{StaticResource PauseGeometry}" Fill="{DynamicResource OnPrimaryContainerBrush}"/></Viewbox></Grid></Button>
                                <Button x:Name="NextMediaButton" Style="{StaticResource IconButtonStyle}" IsEnabled="False" Click="NextMediaButton_Click"><Viewbox Width="14" Height="14"><Path Data="{StaticResource NextGeometry}" Fill="{DynamicResource PrimaryTextBrush}"/></Viewbox></Button>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerBrush}" Margin="0,2"/>

                    <!-- The clock is the visual anchor, matching the concept layout. -->
                    <Grid Grid.Column="2" Margin="16,0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="122"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="ExpandedWeekdayText" Text="Saturday" FontSize="8.5" Foreground="{DynamicResource TertiaryTextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="ExpandedClockText" Text="13:00" FontSize="38" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" LineHeight="42"/>
                                <TextBlock x:Name="ExpandedDateText" Text="Aug 22" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>
                            <UniformGrid Grid.Column="2" Columns="3" Margin="10,0,0,0" VerticalAlignment="Center">
                                <controls:RadialMeter x:Name="CpuRadialMeter" Width="50" Height="50" Label="CPU" Value="0" ProgressBrush="{DynamicResource AccentBrush}" TrackBrush="{DynamicResource DividerBrush}" TextBrush="{DynamicResource PrimaryTextBrush}" SecondaryTextBrush="{DynamicResource TertiaryTextBrush}" HorizontalAlignment="Center"/>
                                <controls:RadialMeter x:Name="GpuRadialMeter" Width="50" Height="50" Label="GPU" Value="0" ProgressBrush="{DynamicResource AccentBrush}" TrackBrush="{DynamicResource DividerBrush}" TextBrush="{DynamicResource PrimaryTextBrush}" SecondaryTextBrush="{DynamicResource TertiaryTextBrush}" HorizontalAlignment="Center"/>
                                <controls:RadialMeter x:Name="RamRadialMeter" Width="50" Height="50" Label="RAM" Value="0" ProgressBrush="{DynamicResource AccentBrush}" TrackBrush="{DynamicResource DividerBrush}" TextBrush="{DynamicResource PrimaryTextBrush}" SecondaryTextBrush="{DynamicResource TertiaryTextBrush}" HorizontalAlignment="Center"/>
                            </UniformGrid>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="POWER" FontSize="7.5" Foreground="{DynamicResource TertiaryTextBrush}"/>
                                <TextBlock x:Name="OverviewPowerText" Text="Balanced" FontSize="9" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock x:Name="OverviewThermalLabel" Text="THERMAL" FontSize="7.5" Foreground="{DynamicResource TertiaryTextBrush}"/>
                                <TextBlock x:Name="OverviewThermalText" Text="--" FontSize="9" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="DiscordVoiceGroup" Grid.Row="2" Margin="0,5,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" MinWidth="0">
                                <StackPanel Orientation="Horizontal"><TextBlock x:Name="DiscordVoiceStateText" Text="Discord" FontSize="10.5" FontWeight="SemiBold"/><TextBlock x:Name="DiscordVoiceChannelText" Text="Not in voice" FontSize="9.5" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="6,0,0,0" MaxWidth="145"/></StackPanel>
                                <TextBlock x:Name="DiscordVoiceDetailText" Text="Discord is not connected" FontSize="8.5" Foreground="{DynamicResource TertiaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                <StackPanel x:Name="DiscordVoiceStatusStrip" Orientation="Horizontal" Visibility="Collapsed"><TextBlock x:Name="DiscordVoiceStatusText" Text="Mic live &#183; Audio on" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="DiscordVoiceControlsPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed">
                                <Button x:Name="DiscordMuteButton" Style="{StaticResource IconButtonStyle}" Width="27" Height="27" Margin="0,0,2,0" Click="DiscordMuteButton_Click" ToolTip="Mute / unmute microphone" AutomationProperties.Name="Toggle Discord microphone"><Viewbox Width="12" Height="12"><Path Data="{StaticResource MicGeometry}" Fill="{DynamicResource PrimaryTextBrush}"/></Viewbox></Button>
                                <Button x:Name="DiscordDeafenButton" Style="{StaticResource IconButtonStyle}" Width="27" Height="27" Margin="0,0,2,0" Click="DiscordDeafenButton_Click" ToolTip="Speaker mute / unmute" AutomationProperties.Name="Toggle Discord speaker mute"><Viewbox Width="12" Height="12"><Path Data="{StaticResource HeadphonesGeometry}" Fill="{DynamicResource PrimaryTextBrush}"/></Viewbox></Button>
                                <Button x:Name="DiscordDisconnectButton" Style="{StaticResource IconButtonStyle}" Width="27" Height="27" Click="DiscordDisconnectButton_Click" ToolTip="Leave Discord voice" AutomationProperties.Name="Leave Discord voice"><Viewbox Width="12" Height="12"><Path Data="{StaticResource HangupGeometry}" Fill="#FFE15B64"/></Viewbox></Button>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="OverviewAudioGroup" Grid.Row="2" Margin="0,5,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" MinWidth="0">
                                <TextBlock Text="OUTPUT" FontSize="7.5" Foreground="{DynamicResource TertiaryTextBrush}"/>
                                <TextBlock x:Name="OverviewAudioDeviceText" Text="Default audio" FontSize="9.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="185"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0">
                                <TextBlock Text="VOLUME" FontSize="7.5" Foreground="{DynamicResource TertiaryTextBrush}" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="OverviewAudioVolumeText" Text="--" FontSize="9.5" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border x:Name="NotificationSeparator" Grid.Column="3" Width="1" Background="{DynamicResource DividerBrush}" Margin="0,2" Visibility="Collapsed"/>

                    <!-- Notifications occupy the reference image's top-right region only when present. -->
                    <StackPanel x:Name="NotificationStripGroup" Grid.Column="4" VerticalAlignment="Center" Margin="16,0,0,0" Visibility="Collapsed">
                        <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="NOTIFICATIONS" FontSize="8.5" Foreground="{DynamicResource TertiaryTextBrush}"/>
                            <Button Grid.Column="1" Content="Clear all" FontSize="8" Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderThickness="0" Padding="4,1" Cursor="Hand" Click="ClearNotificationsButton_Click"/>
                        </Grid>
                        <Grid x:Name="NotificationItem1Group">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border x:Name="NotificationIconBorder1" Grid.Column="0" Width="16" Height="16" CornerRadius="4" Background="#14FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,4,0"><Grid><Image x:Name="NotificationIcon1" Stretch="UniformToFill"/><TextBlock x:Name="NotificationIconFallback1" Text="N" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
                            <TextBlock x:Name="NotificationPrimaryText" Grid.Column="1" Text="No notifications" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="NotificationAge1Text" Grid.Column="2" FontSize="8" Foreground="{DynamicResource TertiaryTextBrush}" Margin="7,0,0,0"/>
                        </Grid>
                        <TextBlock x:Name="NotificationDetailText" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="20,1,0,5"/>
                        <Grid x:Name="NotificationItem2Group" Visibility="Collapsed" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border x:Name="NotificationIconBorder2" Grid.Column="0" Width="15" Height="15" CornerRadius="4" Background="#14FFFFFF" HorizontalAlignment="Left" Margin="0,0,4,0"><Grid><Image x:Name="NotificationIcon2" Stretch="UniformToFill"/><TextBlock x:Name="NotificationIconFallback2" Text="N" FontSize="7.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
                            <TextBlock x:Name="NotificationPrimary2Text" Grid.Column="1" FontSize="9" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="NotificationAge2Text" Grid.Column="2" FontSize="8" Foreground="{DynamicResource TertiaryTextBrush}" Margin="7,0,0,0"/>
                        </Grid>
                        <Grid x:Name="NotificationItem3Group" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border x:Name="NotificationIconBorder3" Grid.Column="0" Width="15" Height="15" CornerRadius="4" Background="#14FFFFFF" HorizontalAlignment="Left" Margin="0,0,4,0"><Grid><Image x:Name="NotificationIcon3" Stretch="UniformToFill"/><TextBlock x:Name="NotificationIconFallback3" Text="N" FontSize="7.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
                            <TextBlock x:Name="NotificationPrimary3Text" Grid.Column="1" FontSize="9" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="NotificationAge3Text" Grid.Column="2" FontSize="8" Foreground="{DynamicResource TertiaryTextBrush}" Margin="7,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center"/>

                <Grid Grid.Row="2" Height="112">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition x:Name="DownloadLeadingSeparatorColumn" Width="0"/>
                        <ColumnDefinition x:Name="DownloadColumn" Width="0" MinWidth="0"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*" MinWidth="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- Timers -->
                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="TIMERS" FontSize="8.5" Foreground="{DynamicResource TertiaryTextBrush}" Margin="0,0,0,4"/>
                        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="FocusTimerLabelText" Text="Focus" FontSize="10" VerticalAlignment="Center"/><TextBlock x:Name="FocusTimerText" Grid.Column="1" Text="25:00" FontSize="10.5" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Margin="8,0" VerticalAlignment="Center"/><Button x:Name="FocusToggleButton" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="24" Height="24" Click="FocusToggleButton_Click" AutomationProperties.Name="Toggle focus timer"><Grid Width="11" Height="11"><Viewbox x:Name="FocusPlayIconViewbox" Width="11" Height="11"><Path Data="{StaticResource PlayGeometry}" Fill="{DynamicResource PrimaryTextBrush}"/></Viewbox><Viewbox x:Name="FocusPauseIconViewbox" Width="11" Height="11" Visibility="Collapsed"><Path Data="{StaticResource PauseGeometry}" Fill="{DynamicResource PrimaryTextBrush}"/></Viewbox></Grid></Button></Grid>
                        <ProgressBar x:Name="FocusTimerProgressBar" Grid.Row="2" Style="{StaticResource MediaProgressStyle}" Minimum="0" Maximum="1" Value="0" Height="3" Margin="0,1,30,2" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Grid Grid.Row="3" Margin="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Break" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/><TextBlock Text="45:00" Grid.Column="1" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Typography.NumeralAlignment="Tabular" Margin="8,0" VerticalAlignment="Center"/><Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="24" Height="24" Click="Break45Button_Click"><Viewbox Width="11" Height="11"><Path Data="{StaticResource PlayGeometry}" Fill="{DynamicResource SecondaryTextBrush}"/></Viewbox></Button></Grid>
                    </Grid>

                    <Border x:Name="DownloadLeadingSeparator" Grid.Column="1" Width="1" Background="{DynamicResource DividerBrush}" Margin="0,3"/>

                    <!-- The middle lane is useful even when there is no download. Downloads replace this real app-session data only while bytes are moving. -->
                    <Grid x:Name="SessionGroup" Grid.Column="2" Margin="16,0" VerticalAlignment="Center">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="SESSION" FontSize="8.5" Foreground="{DynamicResource TertiaryTextBrush}"/>
                        <TextBlock x:Name="SessionProcessText" Grid.Row="1" Text="Windows" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                        <TextBlock x:Name="SessionDetailText" Grid.Row="2" Text="Memory -- · Threads -- · Up --" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </Grid>

                    <!-- Downloads only exist while bytes are actively changing. -->
                    <Grid x:Name="DownloadGroup" Grid.Column="2" Visibility="Collapsed" Margin="16,0" VerticalAlignment="Center">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="DOWNLOADS" FontSize="8.5" Foreground="{DynamicResource TertiaryTextBrush}"/>
                        <StackPanel x:Name="DownloadItem1Group" Grid.Row="1" Margin="0,5,0,0"><TextBlock x:Name="DownloadPrimaryText" Text="No active downloads" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="DownloadDetailText" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" Margin="0,1,0,0"/></StackPanel>
                        <StackPanel x:Name="DownloadItem2Group" Grid.Row="2" Margin="0,5,0,0" Visibility="Collapsed"><TextBlock x:Name="DownloadSecondaryText" FontSize="9.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="DownloadSecondaryDetailText" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular"/></StackPanel>
                        <ProgressBar x:Name="DownloadActivityProgressBar" Grid.Row="3" Style="{StaticResource MediaProgressStyle}" IsIndeterminate="True" Visibility="Collapsed" Height="4" Margin="0,6,0,0"/>
                    </Grid>

                    <Border Grid.Column="3" Width="1" Background="{DynamicResource DividerBrush}" Margin="0,3"/>

                    <!-- System details use the spare lower-row width instead of pushing values to the far edge. -->
                    <Grid Grid.Column="4" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="SYSTEM" FontSize="8.5" Foreground="{DynamicResource TertiaryTextBrush}" Margin="0,0,0,6"/>
                        <UniformGrid Grid.Row="1" Columns="3">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Storage" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock x:Name="StorageText" Text="-- free" FontSize="9.5" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                <ProgressBar x:Name="StorageProgressBar" Style="{StaticResource MediaProgressStyle}" Minimum="0" Maximum="1" Value="0" Height="4" Margin="0,5,0,0" IsHitTestVisible="False"/>
                            </StackPanel>
                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0" Padding="12,0">
                                <StackPanel>
                                    <TextBlock Text="Network" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock x:Name="ExpandedNetworkText" Text="&#x2193; 0.0  &#x2191; 0.0 Mbps" FontSize="9.5" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0" Padding="12,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Hardware" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock x:Name="HardwareDetailText" Text="Temperature unavailable" FontSize="9.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    <StackPanel x:Name="BatteryStripGroup" Orientation="Horizontal" Visibility="Collapsed" Margin="0,2,0,0"><TextBlock x:Name="BatteryText" FontSize="9"/><TextBlock x:Name="BatteryStateText" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="4,0,0,0"/></StackPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock x:Name="ExpandedSystemText" Visibility="Collapsed"/>
                        <Border x:Name="BatterySeparator" Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
